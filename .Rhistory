export_dir <- here::here("abstention_geneve", "figures")
dir.create(export_dir, showWarnings = FALSE)
walk(
list(
list(g_w1,      "W1_waffle_non.png",        5, 8),
list(g_w2,      "W2_waffle_oui.png",         5, 8),
list(g_w3,      "W3_waffle_abstention.png",  5, 8),
list(g_w2_1,      "W1_waffle_non_2.png",  5, 8),
list(g_w2_2,      "W2_waffle_oui_2.png",  5, 8),
list(g_w2_3,      "W3_waffle_abstention_2.png",  5, 8),
list(g_w2_4,      "W4_waffle_etrangers_complet.png",   5, 8),
list(g2_1,      "G21_age.png",      9, 6),
list(g2_2,      "G22_age_HF.png",           9, 6),
list(gt1_1,       "GT1_age_temps.png",          9, 5),
list(gt1_2,       "GT2_age_temps.png",          9, 5),
#list(gc1,       "Carte.png",          9, 5),
#list(gc2_1, "corr_densité_vote_1.png",           9, 5),
#list(gc2_2, "corr_densité_vote_2.png",           9, 5),
#list(gc2_3, "corr_densité_vote_3.png",           9, 5),
#list(gc2_4, "corr_densité_vote_4_manip.png",    9, 5),
list(gc3,       "violonplot_distrib_participation.png",            9, 5)
),
